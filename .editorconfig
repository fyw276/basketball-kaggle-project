# EditorConfig - 跨平台编辑器配置
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,dart}]
indent_style = space
indent_size = 4

[*.{json,yaml,yml,md}]
indent_style = space
indent_size = 2

[*.{sh,bat,ps1}]
indent_style = space
indent_size = 2
