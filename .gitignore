# Python: virtualenv / setuptools layout at REPO ROOT ONLY.
# CRITICAL: Do NOT use bare `lib/` here — it matches every `lib/` in the tree (e.g. mobile/lib/) and
# Flutter/Dart sources will disappear from `git status` and never get committed.
/lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
