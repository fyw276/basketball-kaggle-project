# 跨平台行尾符配置
* text=auto

# Python 文件
*.py text eol=lf
*.pyi text eol=lf

# Dart/Flutter 文件
*.dart text eol=lf

# 配置文件
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf

# 脚本文件
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Markdown 文件
*.md text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.h5 binary
*.pb binary
*.pth binary
*.onnx binary
*.tflite binary
