# 复制到 ECS 上 backend/.env 中对应段落（与 deploy_full_to_ecs 解压目录无关的持久化路径）。
# 目标：账户衣橱照片、上传图与数据库不因「发版 / 刷新页面 / 清理 backend 目录」而丢失。
#
# 1) 在服务器创建目录（示例，可改用单独云盘挂载点）：
#    sudo mkdir -p /var/lib/clothing-assistant/{uploads,data}
#    sudo chown -R root:root /var/lib/clothing-assistant   # 若 systemd 用别的用户，改为该用户
#
# 2) 若旧数据在 $RemoteAppRoot/backend/uploads，一次性迁移（无 rsync 可用 cp -a）：
#    sudo cp -a /opt/clothing-assistant/clothing-assistant-main/backend/uploads/. \
#      /var/lib/clothing-assistant/uploads/
#    改 UPLOAD_DIR 后若未做这步，智能穿搭「一键生成」会因找不到参考图而失败。
#
# 3) SQLite 绝对路径：SQLAlchemy 需要四个斜杠 sqlite://// 再接绝对路径。
#
ENVIRONMENT=production
DEBUG=False

# 图片与上传文件（必须绝对路径，勿用 ./uploads）
UPLOAD_DIR=/var/lib/clothing-assistant/uploads

# 数据库：推荐 PostgreSQL；若暂用 SQLite，库文件也必须独立于代码目录
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/outfit_db
DATABASE_URL=sqlite:////var/lib/clothing-assistant/data/outfit.db
