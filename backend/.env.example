# 复制本文件为 .env 后再启动后端：copy .env.example .env（勿将含真实密钥的 .env 提交到 Git）
#
# Application
APP_NAME="Smart Outfit Assistant"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# Server（默认 8010，与 mobile/lib/core/services/api_port_config.dart 中 kApiPort 一致）
HOST=0.0.0.0
PORT=8010
WORKERS=4

# Database（本地无 PostgreSQL 时可改用 SQLite，一行即可跑通后端）
DATABASE_URL=postgresql://user:password@localhost:5432/outfit_db
# DATABASE_URL=sqlite:///./outfit_local.db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# JWT Authentication（上线前必须改为强随机密钥；开发环境勿使用仓库默认值）
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# File Upload（开发可用相对路径；生产务必改为绝对路径，见 docs/PRODUCTION_DEPLOY.md）
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10 MB in bytes

# Model Configuration
MODEL_PATH=../models
MODEL_CACHE_SIZE=1000

# Hybrid inference（本地主推理 + 外部增强）
HYBRID_INFERENCE_ENABLED=True
EXTERNAL_ENHANCE_ENABLED=False
LOW_CONF_THRESHOLD=0.62
HIGH_CONF_THRESHOLD=0.78
MARGIN_THRESHOLD=0.08
LOCAL_WEIGHT=0.65
EXTERNAL_WEIGHT=0.35
LOCAL_INFER_TIMEOUT_MS=1200
EXTERNAL_INFER_TIMEOUT_MS=1800
# EXTERNAL_API_BASE_URL=https://your-enhance-api.example.com
# EXTERNAL_API_KEY=replace_me
# EXTERNAL_API_PATH=/infer

# 微调推断（可选）：有可用 API 时可开启；失败会自动降级到本地 CLIP
# 支持：DashScope（阿里百炼）、本地微调模型等
# DashScope 示例（阿里云百炼）：
FINETUNED_INFER_ENABLED=true
FINETUNED_INFER_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINETUNED_INFER_API_PATH=/chat/completions
FINETUNED_INFER_API_KEY=your-dashscope-api-key-here
FINETUNED_INFER_TIMEOUT_MS=3000

# Hugging Face（CLIP / 虚拟试衣首次需联网下载；国内访问 huggingface.co 常超时）
# 下列键已在 Settings 中声明：启动时 sync_hf_env_from_settings 会写入 os.environ，huggingface_hub 才能读到。
# 任选其一：镜像（推荐） / 仅加长超时（大模型建议 300～600）
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DOWNLOAD_TIMEOUT=600
# 模型体积：vit_b32 更小、vit_l14 更准（需在代码中配置 CLIP 变体时一致）

# 虚拟试衣（diffusers）模型
# 默认使用公开可用的 inpainting 模型；若你改用 gated 模型（例如 stabilityai/*），需要：
# 1) 在 HF 网站上同意条款；2) 配置 HF_TOKEN（访问令牌）
# SD_VTON_MODEL_ID=runwayml/stable-diffusion-inpainting
# HF_TOKEN=hf_xxx

# 虚拟试衣 v2（方案 A）配置
TRYON_BOTTOM_FORCE_FALLBACK=true
TRYON_V2_ENABLED=true
TRYON_V2_STRICT_IDENTITY=true
TRYON_V2_MIN_FULL_BODY_SCORE=0.55
TRYON_V2_MIN_LEG_VISIBILITY_SCORE=0.45
TRYON_V2_MIN_FRONT_POSE_SCORE=0.35
TRYON_V2_MIN_GARMENT_FRONT_SCORE=0.45
TRYON_V2_QC_THRESHOLD=0.6
TRYON_V2_TIMEOUT_MS=12000
TRYON_V2_AUTO_PREPROCESS=true
# v2 mode=replace：默认禁止回退本机 diffusers（权重/cache 不完整时容易生成无关图像）
TRYON_V2_REPLACE_ALLOW_LOCAL_DIFFUSION=false

# v2 replace 引擎优先级（逗号分隔）：warp(几何贴合), bailian(百炼), remote(远程VTON), catvton(本地CatVTON), diffusion(本地diffusion)
TRYON_V2_REPLACE_ENGINE_PRIORITY=warp,bailian,remote,catvton,diffusion

# v2 replace 跳过几何贴合，直接使用 AI 生成（设为 true 可跳过 warp）
TRYON_V2_REPLACE_SKIP_WARP=false

# ─── CatVTON 本地试衣引擎 ─────────────────────────────────────────────────────────────────
# CatVTON 虚拟试衣引擎（推荐用于本地高质量试衣，需 NVIDIA GPU 8GB+ VRAM，bf16 精度）
# 官网: https://github.com/Zheng-Chong/CatVTON
# 安装方法: git clone https://github.com/Zheng-Chong/CatVTON.git
# 启用后会自动调用本地 CatVTON 进行试衣推理
# CATVTON_ENABLED=true
# CatVTON 仓库路径（需先 git clone）
# CATVTON_PATH=D:\models\CatVTON
# 输入图像尺寸（768x1024 是质量和速度的平衡）
# CATVTON_WIDTH=768
# CATVTON_HEIGHT=1024
# 推理步数（30-80，推荐 50）
# CATVTON_STEPS=50
# CFG 强度（2.0-3.0，推荐 2.5，越高服装保真度越高）
# CATVTON_GUIDANCE=2.5
# 是否使用背景重绘（repaint 模式恢复原始背景）
# CATVTON_REPAINT=true
# 混合精度：bf16（推荐，约需 8GB VRAM）/ fp16 / no（fp32，禁用混合精度）
# CATVTON_MIXED_PRECISION=bf16
# 单次推理超时（秒，50步约需 30-60 秒）
# CATVTON_TIMEOUT_SECONDS=600

# 离线部署（推荐固定缓存目录，便于拷贝到离线机）
# HF_HOME=D:\model-cache\hf
# TRANSFORMERS_CACHE=D:\model-cache\hf\transformers
# 断网运行时开启：
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# 智能穿搭天气/地址：默认气温与天气现象来自 Open-Meteo；国内地址精度建议配高德逆地理 Key。
# 若需「高德实况天气」覆盖温度与天气文案：设 AMAP_WEATHER_ENABLED=true（与 AMAP_WEB_KEY 同属 Web 服务 Key）
# AMAP_WEB_KEY=
# AMAP_WEATHER_ENABLED=false

# AI 推荐解释层（可选，OpenAI 兼容 /v1/chat/completions；关闭则模板兜底，主流程不变）
# 通义千问：在阿里云控制台启用兼容模式后，填控制台给出的 base（通常以 /v1 结尾）
# 豆包：火山方舟 OpenAI 兼容端点 + 控制台模型 ID
# AI_RECOMMENDER_ENABLED=false
# AI_RECOMMENDER_API_BASE_URL=https://api.openai.com/v1
# AI_RECOMMENDER_API_KEY=
# AI_RECOMMENDER_MODEL=gpt-4o-mini
# AI_RECOMMENDER_TIMEOUT_MS=8000

# 对象存储（未在默认代码中实现；多机持久化时再评估 S3/OSS，需改 StorageService）

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_ALL_LOCALHOST=true
# CORS_ALLOW_PATTERN: Regex pattern for allowed origins (e.g., https://.*\.your-domain\.com)
# Uncomment and configure this to allow specific domain patterns in production
# CORS_ALLOW_PATTERN=https://.*\.your-domain\.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Rate Limiting（默认关闭，避免误伤本地/单测；生产可设 ENABLE_RATE_LIMIT=true）
ENABLE_RATE_LIMIT=false
RATE_LIMIT_PER_MINUTE=60

# 发布台账与运维 HTML看板（可选，见 docs/OPS_RELEASE_AND_OBSERVABILITY.md）
# RELEASE_MANIFEST_PATH=
# RELEASE_FRONTEND_INDEX_SHA256=
# RELEASE_BACKEND_GIT_COMMIT=
# RELEASE_DEPLOY_TIME_UTC=
# OPS_DASHBOARD_ENABLED=false


DASHSCOPE_TRYON_ENABLED=true
DASHSCOPE_API_KEY=sk-66c18c64b2f840ba9be6a29cb7743e04

# 默认模型：不写也会用这个
DASHSCOPE_TRYON_MODEL=wanx2.1-imageedit

# 按品类可单独覆盖（先都用同一个，后面你再替换成更适合的）
DASHSCOPE_TRYON_MODEL_TOP=wanx2.1-imageedit
DASHSCOPE_TRYON_MODEL_BOTTOM=wanx2.1-imageedit
DASHSCOPE_TRYON_MODEL_SKIRT=wanx2.1-imageedit

# 功能：description_edit_with_mask = 基于衣服区域 mask 的局部编辑（保留人物身份，推荐）
# 旧值 stylization_all 是风格迁移，会忽略人物身份生成新人，不适合试衣
DASHSCOPE_TRYON_FUNCTION=description_edit_with_mask

# ─── 远程 VTON 推理服务 ─────────────────────────────────────────────────────────────────
# 远程 VTON 服务 URL（如使用独立的 VTON 推理微服务）
# VTON_INFERENCE_URL=http://127.0.0.1:8011/v1/tryon
# VTON_INFERENCE_TIMEOUT_SECONDS=2400
# VTON_INFERENCE_API_KEY=
